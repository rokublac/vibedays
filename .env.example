# Spotify app Client ID, from https://developer.spotify.com/dashboard
#
# This is a PUBLIC identifier, not a secret. PKCE means the app needs no client
# secret, so there is never anything private to keep out of this file.
#
# Copy this file to .env and paste your own Client ID below.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Prints the [hb] play-path logs (search rungs, playlist choice,
# playback calls) to the console during development. Off by default.
# You can also flip it live in the browser with: localStorage.hb_debug = '1'
# VITE_DEBUG=true
