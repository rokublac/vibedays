# vibedays needs no configuration to run — there are no keys and no accounts.
# Music comes from the Audius public API, which requires neither.

# Optional. Prints the [hb] play-path logs (the resolved vibe, the search
# it ran, playback calls) to the console during development. Off by default.
# You can also flip it live in the browser with: localStorage.hb_debug = '1'
# VITE_DEBUG=true
